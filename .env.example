# Client
VITE_SERVER_URL=http://localhost:3000
VITE_SERVER_PORT=3000

# Server
SERVER_PORT=3000
TICK_RATE=20
MAX_PLAYERS=10
# Reforged capabilities are strict server-owned opt-ins. Keep every unfinished
# capability false in production; only the literal value true enables one.
CAPABILITY_NEW_SHELL=false
CAPABILITY_SCHEDULES=false
CAPABILITY_LARGE_WORLDS=false
CAPABILITY_MODERN_ART=false
CAPABILITY_BATTLE_ROYALE=false
# Optional smoke pin: hot_shot, heavy_hitter, on_a_roll, road_warrior,
# powder_keg, hill_dweller, or tag_hunter.
FORCE_CONTRACT=
# Where persistent lifetime stats live (persistent-stats.json).
# Defaults to server/data/ when unset.
DATA_DIR=
