{
  "name": "mighty-mans-revenge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"pnpm --filter @game/client dev\" \"pnpm --filter @game/server dev\"",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "baseline:server": "pnpm --filter @game/server baseline:evidence",
    "baseline:client": "playwright test --config e2e/playwright.config.ts e2e/tests/baseline-evidence.test.ts",
    "assets:validate": "node tools/reforged-assets/asset-pipeline.mjs validate",
    "assets:build": "node tools/reforged-assets/asset-pipeline.mjs build",
    "assets:generate:modern-ui": "node tools/reforged-assets/create-modern-ui-sources.mjs",
    "test:assets": "node --test tools/reforged-assets/*.test.mjs",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,md}\"",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.4.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
